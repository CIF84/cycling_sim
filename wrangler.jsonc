{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bike-science-pro",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "preview": {
      "name": "bike-science-pro-preview",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
  },
}
